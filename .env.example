# 服务
PORT=80
PUBLIC_BASE_URL=http://YOUR_SERVER_IP

# MySQL
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/chongdong
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=chongdong
MYSQL_USER=
MYSQL_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=（openssl rand -hex 48 生成）
JWT_REFRESH_SECRET=（openssl rand -hex 48 生成）
ACCESS_TOKEN_TTL=604800
REFRESH_TOKEN_TTL=2592000

# 短信（内测万能码模式，勿面向真实用户）
SMS_FAKE_ENABLED=true
SMS_FAKE_CODE=8888
SMS_DAILY_LIMIT=10
SMS_CODE_TTL=300

# 文件上传
UPLOAD_AVATAR_MAX_BYTES=2097152
UPLOAD_WALKPHOTO_MAX_BYTES=1048576
